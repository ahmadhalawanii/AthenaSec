# Copy this file to backend/.env and fill it in. The API, `alembic` and the
# account command all read it. Never commit the real .env.

# ----- Database (required for sign-in) ---------------------------------------
# PostgreSQL holds users, sessions, approvals and the audit trail.
ATHENASEC_PERSISTENCE_BACKEND=postgres
ATHENASEC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/athenasec

# ----- Sign-in -----------------------------------------------------------------
# 64 hex characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it later breaks every enrolled authenticator app.
ATHENASEC_TOTP_MASTER_KEY=

# false only for local development over http://localhost. Leave true in production (https).
ATHENASEC_COOKIE_SECURE=false

# The website's address (comma separated if more than one)
ATHENASEC_CORS_ORIGINS=http://localhost:5173

# ----- Agent -------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# SHADOW, SUPERVISED (default) or AUTONOMOUS; see app/services/policy/response_mode.py
ATHENASEC_RESPONSE_MODE=SUPERVISED

# mock, or wazuh to read evidence from the Wazuh indexer below
ATHENASEC_EVIDENCE_PROVIDER=mock

# Trained classifier used at runtime (leave unset to run without ML)
ATHENASEC_ML_MODEL_PATH=models/athenasec-classifier-v3.pkl

# ----- Wazuh -------------------------------------------------------------------
# Key the Wazuh forwarder (integrations/custom-athenasec.py) sends with each alert
ATHENASEC_WAZUH_INGEST_KEY=

WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_SSL=false

# ----- Threat intelligence and response (optional) ----------------------------
MISP_URL=
MISP_API_KEY=
CORTEX_URL=
CORTEX_API_KEY=
# MISP and Cortex on the AthenaSec server use self-signed certificates. Either trust the
# certificate (preferred) or, for services on this same machine only, skip the check.
#   MISP_CA_BUNDLE=/path/to/misp-cert.pem      MISP_VERIFY_SSL=false
#   CORTEX_CA_BUNDLE=/path/to/cortex-cert.pem  CORTEX_VERIFY_SSL=false
MISP_VERIFY_SSL=true
CORTEX_VERIFY_SSL=true
CORTEX_BLOCK_IP_RESPONDER_ID=
CORTEX_UNBLOCK_IP_RESPONDER_ID=
CORTEX_VERIFY_BLOCK_IP_RESPONDER_ID=
